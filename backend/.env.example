# Axiom Backend Environment Configuration Template
# Copy this file to .env and populate your API keys.

# ==============================================================================
# AI Provider API Keys (Supports comma-separated keys for pool rotation)
# ==============================================================================
# Groq Cloud API Keys: https://console.groq.com/keys
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2

# Google Gemini API Keys: https://aistudio.google.com/
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# OpenRouter API Keys: https://openrouter.ai/keys
OPENROUTER_API_KEYS=your_openrouter_api_key_1,your_openrouter_api_key_2

# ==============================================================================
# Agentic Web Search (Tavily API)
# ==============================================================================
# Tavily Search API Keys: https://tavily.com/
TAVILY_API_KEYS=your_tavily_api_key_1,your_tavily_api_key_2

# ==============================================================================
# Primary Model Overrides (Optional - defaults to verified free high-capacity models)
# ==============================================================================
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free

# ==============================================================================
# Orchestration & Failover Tuning (Optional)
# ==============================================================================
# Cascade priority order (comma-separated provider names)
PROVIDER_ORDER=groq,gemini,openrouter

# Providers designated for multimodal vision queries
VISION_PROVIDERS=gemini,groq,openrouter

# Timeouts in seconds
FIRST_TOKEN_TIMEOUT=8.0
NEXT_TOKEN_TIMEOUT=20.0

# ==============================================================================
# Admin / Chaos controls (REQUIRED to use the cockpit's failure-injection buttons)
# ==============================================================================
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# If empty, all /api/debug/* and /api/models/* endpoints are disabled.
ADMIN_TOKEN=

# ==============================================================================
# CORS (which websites may call this backend, comma-separated, no trailing slash)
# ==============================================================================
# Local dev default is shown. In production set this to your real frontend URL,
# e.g. CORS_ORIGINS=https://chat.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Rate limits (requests per minute, per client IP; 0 disables a limit)
# ==============================================================================
RATE_LIMIT_CHAT=20
RATE_LIMIT_TITLE=30
RATE_LIMIT_EXTRACT=10
RATE_LIMIT_ADMIN=30
# AI tool calls per minute per client (0 disables an individual limit)
RATE_LIMIT_TOOL_RESUME=10
RATE_LIMIT_TOOL_CODE_REVIEW=10
RATE_LIMIT_TOOL_SQL_ASSISTANT=15
RATE_LIMIT_TOOL_MEETING=10
RATE_LIMIT_TOOL_PDF=10
# Max size of a chat request body in MB (images are sent inline)
MAX_CHAT_BODY_MB=16
# Max size of an AI tool request body in MB
MAX_TOOL_BODY_MB=4
# Maximum combined body size for PDF uploads, including multipart overhead
MAX_PDF_BODY_MB=50
# Set to 1 ONLY when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0

# ==============================================================================
# Conversation size budget
# ==============================================================================
# Max characters of chat history sent to a model (about 4 characters = 1 token).
# Oldest messages are dropped first; the newest is always kept. 0 disables trimming.
CONTEXT_CHAR_BUDGET=48000

# ==============================================================================
# PDF Tutor / RAG indexing
# ==============================================================================
# Target PDF chunk size and overlap, measured approximately at 4 characters/token
PDF_CHUNK_TOKENS=650
PDF_CHUNK_OVERLAP_TOKENS=100
# Maximum pages per uploaded PDF; scanned pages without text are rejected
PDF_MAX_PAGES=150
# Maximum number of PDFs in one request
PDF_MAX_FILES=5
# Maximum total PDFs retained in each owner's library
PDF_MAX_DOCUMENTS=25
# Gemini embedding model; missing/unavailable embedding keys use FTS retrieval
PDF_EMBEDDING_MODEL=models/text-embedding-004
# Maximum meeting transcript chars retained per request (long transcripts are chunked)
MEETING_MAX_CHARS=120000
MEETING_CHUNK_CHARS=12000

# ==============================================================================
# Gateway product (optional)
# ==============================================================================
# If set, chat/title/extract/OpenAI-compat require this Bearer token (or a minted user key)
AXIOM_API_KEY=
# Automatically requires a configured key when ENVIRONMENT=production.
ENVIRONMENT=development
AUTH_REQUIRED=
# Daily quotas per client (IP or API key id)
DAILY_REQUESTS=200
DAILY_TOKENS=500000
# Routing: failover | latency | cost | quality | auto
ROUTING_MODE=failover
# Circuit breaker: open a provider after N consecutive failures
CIRCUIT_THRESHOLD=4
CIRCUIT_OPEN_SECS=60
HEALTH_PROBE_SECS=90
# SQLite directory (quotas, shares, vault, RAG)
AXIOM_DATA_DIR=
# Comma-separated MCP hostnames allowed to use HTTP or resolve to private IPs.
MCP_ALLOWED_HOSTS=
# OpenRouter model used by the generate_image tool
IMAGE_MODEL=black-forest-labs/flux.2-schnell:free
